{
  "name": "wardogs-presence",
  "version": "1.1.1",
  "description": "Local War Dogs screen status for Discord webhooks",
  "author": "THEROCKSSS and contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.therocksss.wardogs-presence",
    "productName": "WARDOGS Presence",
    "asar": true,
    "files": [
      "desktop/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": ".tools/engine-dist/WardogsPresence", "to": "engine" }
    ],
    "directories": { "output": "dist" },
    "win": {
      "target": "portable",
      "icon": "assets/wardogs.ico",
      "artifactName": "WardogsPresence-${version}-win-x64.exe"
    },
    "portable": { "artifactName": "WardogsPresence-${version}-win-x64.exe" }
  }
}
